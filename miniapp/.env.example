# Базовый адрес REST API плагина InsurWP.
# Разработка: /api — запрос идёт через прокси Vite и не упирается в CORS.
# Прод: https://bginfo.eu/wp-json/insurwp/v1 — адрес должен быть разрешён
# в админке WordPress: «Страховка → Настройки → Адреса мини-аппа».
VITE_INSURWP_API_BASE=

# Куда прокси Vite шлёт запросы с /api в разработке.
# По умолчанию https://bginfo.eu; укажите свой адрес, чтобы работать
# против локального WordPress.
VITE_INSURWP_API_PROXY=
